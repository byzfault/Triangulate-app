# Free key from https://www.solanatracker.io/data-api  (Free plan: 10,000 requests/month, 3 req/s)
SOLANA_TRACKER_API_KEY=

# --- Everything below is optional; these are the defaults ---

PORT=3000
SOLANA_TRACKER_BASE_URL=https://data.solanatracker.io

# Free tier is 3 req/s. Raise only if you upgrade your plan.
RATE_LIMIT_PER_SEC=3

# Hard ceiling on API requests for a single query, so a huge token can't drain your quota.
MAX_REQUESTS_PER_QUERY=1500

# Stop enumerating the anchor token past this many wallets (UI flags results as capped).
# Traders are fetched most-profitable-first, so this keeps the top N and drops the tail.
# Biggest lever on cost: a trending token can have 19,000 traders (~190 requests uncapped).
ANCHOR_WALLET_CAP=2000

# How long cached token/position data stays fresh, in hours.
CACHE_TTL_HOURS=24

# SQLite cache location.
DB_PATH=./data/cache.sqlite

# --- Cost control (shared by every tool) --------------------------------------------
# Solana Tracker's monthly free allowance. When it runs out, work STOPS unless paid
# credit is switched on below — never silently.
SOLANA_TRACKER_FREE_MONTHLY=10000

# Day of the month the allowance resets. Clamped to 1-28.
QUOTA_RESET_DAY=1

# Paid credit is opt-in. Leave false and the tools stop at the free ceiling rather than
# spending money.
PAID_CREDITS_ENABLED=false

# Hard ceiling on paid requests per period, so an unattended job can't run up a bill.
PAID_CREDIT_LIMIT=0

# How often the free GeckoTerminal trade logger polls each watched token, in seconds.
LOGGER_INTERVAL_SECS=90
